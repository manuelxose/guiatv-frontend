# Example environment file for the `functions` service
# Do NOT commit sensitive credentials. Replace placeholders before use.

##### Database (MongoDB) - Atlas example (production)
# Use your Atlas connection string. Ensure the username/password and network access
# (IP whitelist) are configured in your Atlas project.
# Example SRV format with no explicit DB name (app uses MONGODB_DB_NAME):
DB_ADAPTER=mongo
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.jis624m.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=guiatv
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=10000

# If you prefer to include the DB name directly in the URI:
# MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@cluster0.jis624m.mongodb.net/guiatv?retryWrites=true&w=majority

##### Local Mongo (development)
# Quick local testing: run a Docker Mongo and point MONGODB_URI to localhost.
# Uncomment the next two lines for local development.
# DB_ADAPTER=mongo
# MONGODB_URI=mongodb://localhost:27017/guiatv
# MONGODB_DB_NAME=guiatv

##### Storage adapter
# Choose: s3 | local | gcs
STORAGE_ADAPTER=local
STORAGE_LOCAL_PATH=./storage

##### AWS S3 (if STORAGE_ADAPTER=s3)
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

##### Google Cloud Storage (if STORAGE_ADAPTER=gcs)
FIREBASE_STORAGE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

##### Cache / Redis
CACHE_TYPE=memory
# REDIS_URL=redis://localhost:6379

##### App
PORT=4000
NODE_ENV=development
ENABLE_CRON=true

##### Logging
LOG_LEVEL=info

##### Notes & quick commands
# To run a local MongoDB with Docker (Linux/Windows/macOS):
# docker run -d --name guiatv-mongo -p 27017:27017 -e MONGO_INITDB_DATABASE=guiatv mongo:6

# If you plan to use Atlas for development, make sure your current public IP
# is allowed under Network Access (IP whitelist) in the Atlas console. For quick
# testing you can allow access from anywhere (0.0.0.0/0) but this is NOT
# recommended for production.

# Troubleshooting Atlas connection errors:
# - Verify username/password are correct and the user has access to the database.
# - Verify the connection string matches the format shown by Atlas (SRV vs standard).
# - Add your public IP to Network Access (Project -> Network Access -> Add IP Address).
# - Ensure your machine or CI can reach the DNS names used by the SRV record.
NODE_ENV=development
PORT=8080
CORS_ORIGIN=*

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/guiatv
MONGODB_DB_NAME=guiatv

# Storage Configuration
# Options: 'local' or 's3'
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# S3 Configuration (only if STORAGE_TYPE=s3)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=guiatv-media

# Redis Configuration (optional)
REDIS_URL=redis://localhost:6379

# Application Configuration
LOG_LEVEL=info

# External APIs (if needed)
# EPG_API_URL=https://example.com/api
# EPG_API_KEY=your_api_key
