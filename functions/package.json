{
  "name": "functions",
  "version": "1.0.0",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "emulators:start": "npm run build && firebase emulators:start --debug --only functions,firestore,storage,pubsub,ui",
    "emulators:start:no-build": "firebase emulators:start --only functions,firestore,storage,pubsub,ui",
    "dev:emulators": "npm run emulators:start",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "test": "jest"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "async-retry": "^1.3.3",
    "axios": "^1.3.4",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "date-fns": "^2.29.3",
    "esm": "^3.2.25",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^11.10.0",
    "firebase-functions": "^7.0.0",
    "gunzip": "^1.2.2",
    "gunzip-file": "^0.1.1",
    "p-retry": "^5.1.2",
    "redis": "^5.8.3",
    "retry": "^0.13.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xml2js": "^0.4.23"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.13",
    "@types/date-fns": "^2.6.0",
    "@types/express": "^4.17.17",
    "@types/node": "^18.15.5",
    "@types/node-fetch": "^2.6.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xml2js": "^0.4.11",
    "concurrently": "^8.2.2",
    "dotenv": "^16.3.1",
    "firebase-functions-test": "^3.0.0",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.7.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^4.9.5"
  },
  "private": true
}
