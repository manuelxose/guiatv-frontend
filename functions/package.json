{
  "name": "guiatv-backend",
  "version": "1.0.0",
  "description": "Backend Express para GuiaTV (migrado desde Firebase Functions)",
  "scripts": {
    "build": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "start": "node dist/server/index.js",
    "dev": "npm run build && npm start",
    "dev:watch": "nodemon --watch src --ext ts --exec \"npm run dev\"",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "test": "jest",
    "job:syncEPG": "node dist/jobs/cli/syncEPG.cli.js",
    "job:precompute": "node dist/jobs/cli/precomputeSchedules.cli.js",
    "job:clean": "node dist/jobs/cli/cleanOldPrograms.cli.js",
    "migrate:firestore-to-mongo": "node dist/scripts/migrate-firestore-to-mongodb.js"
  },
  "engines": {
    "node": "22"
  },
  "main": "dist/server/index.js",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.682.0",
    "axios": "^1.13.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.0",
    "express": "^4.21.2",
    "mongodb": "^6.10.0",
    "mongoose": "^8.20.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "redis": "^5.10.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xml2js": "^0.6.2"
  },
  "private": true,
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xml2js": "^0.4.14",
    "nodemon": "^3.0.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.3"
  }
}
