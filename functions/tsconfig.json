{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": false,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "types": ["node"],
    "paths": {
      "@v2/*": ["v2/*"],
      "@v2/domain/*": ["v2/domain/*"],
      "@v2/application/*": ["v2/application/*"],
      "@v2/infrastructure/*": ["v2/infrastructure/*"],
      "@v2/presentation/*": ["v2/presentation/*"],
      "@v2/shared/*": ["v2/shared/*"],
      "@v2/config/*": ["v2/config/*"]
    },
    "typeRoots": ["node_modules/@types"]
  },
  "compileOnSave": true,
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "lib"]
}
