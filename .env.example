SILICONFLOW_API_KEY=replace-with-your-key
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_IMAGE_MODEL=black-forest-labs/FLUX.2-pro
SILICONFLOW_IMAGE_SIZE=1024x576
SILICONFLOW_IMAGE_FORMAT=png
SILICONFLOW_DEFAULT_PROJECT=shared
SILICONFLOW_OUTPUT_DIR=generated-assets
TMDB_API_KEY=replace-in-runtime-secret-store

# Server-only football-data.org v4 credentials. Set the real value in the
# runtime secret manager/systemd EnvironmentFile; never expose it as an
# Angular environment variable or commit it here.
FOOTBALL_DATA_API_KEY=replace-in-runtime-secret-store
FOOTBALL_PROVIDER_TIMEOUT_MS=4000
