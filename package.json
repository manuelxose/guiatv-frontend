{
  "name": "guiatv-monorepo",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "apps/backend"
  ],
  "scripts": {
    "build": "npm run build -w apps/backend && npm run build:ssr -w apps/frontend",
    "build:frontend": "npm run build:ssr -w apps/frontend",
    "build:backend": "npm run build -w apps/backend",
    "publish:release": "node scripts/publish-release.mjs",
    "start:api": "npm run start -w apps/backend",
    "start:ssr": "npm run serve:ssr -w apps/frontend",
    "job:syncEPG": "npm run job:syncEPG -w apps/backend",
    "job:precompute": "npm run job:precompute -w apps/backend",
    "job:clean": "npm run job:clean -w apps/backend",
    "migrate:social-data": "npm run migrate:social-data -w apps/backend",
    "seo:submit-sitemap": "npm run seo:submit-sitemap -w apps/backend",
    "db:bootstrap": "npm run create-indexes -w apps/backend && npm run job:syncEPG -w apps/backend && npm run job:precompute -w apps/backend",
    "deploy": "bash ./deploy-guiatv.sh"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "typescript": "5.8.3",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
