STORAGE_BUCKET=guia-tv-8fe3c.appspot.com

# ============================================================================
# Cache Configuration
# ============================================================================
CACHE_TYPE=memory
# REDIS_URL=redis://localhost:6379  # Uncomment if using Redis

# ============================================================================
# CORS Configuration
# ============================================================================
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000,http://localhost:5001,http://localhost:5000

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# Optional Development/Debug Flags
# ============================================================================
# Skip cache connection during initialization (useful for faster emulator startup)
SKIP_CACHE_CONNECT=false

# Container initialization timeout in milliseconds
CONTAINER_INIT_TIMEOUT_MS=15000

# Cache connection timeout in milliseconds
CACHE_CONNECT_TIMEOUT_MS=8000

# Skip scheduled function registration (useful for faster emulator startup)
# SKIP_SCHEDULE_REGISTRATION=false

# Skip project environment detection
# SKIP_PROJECT_ENV=false

# ----------------------
# Database (MongoDB)
# ----------------------
# DB_ADAPTER: 'mongo' (default)
DB_ADAPTER=mongo
# Mongo connection string (change for Atlas or other hosts)
MONGODB_URI=mongodb+srv://manuelxgon:bFaVO0Ci8R2QWcbI@cluster0.jis624m.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=guiatv
MONGODB_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=10000

# ----------------------
# Storage adapter
# ----------------------
# Choose between: s3 | local | gcs
STORAGE_ADAPTER=local
STORAGE_LOCAL_PATH=./storage

# ----------------------
# AWS S3 (if STORAGE_ADAPTER=s3)
# ----------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# ----------------------
# Google Cloud Storage (if STORAGE_ADAPTER=gcs)
# ----------------------
FIREBASE_STORAGE_EMULATOR_HOST=
GOOGLE_APPLICATION_CREDENTIALS=

#Google Client ID
GOOGLE_CLIENT_ID=533857766582-hsp4fsrct6321117n68de3h4ckmqrmab.apps.googleusercontent.com

#JWT
JWT_SECRET="k9V!G4Z7wM92@pQ8#HtBfLxY*3rsDqUeT6&j0bS$PmN1gKdC"
JWT_EXPIRES_IN="7d"

# ----------------------
# Redis / Cache
# ----------------------
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379

# ----------------------
# Application / Server
# ----------------------
PORT=4000
NODE_ENV=development
ENABLE_CRON=true

# ----------------------
# Logging
# ----------------------
LOG_LEVEL=info

# ----------------------
# Misc / Legacy
# ----------------------
FUNCTIONS_BUCKET=guia-tv-8fe3c.appspot.com
SKIP_FIRESTORE_INIT=true

