PORT=8080
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/guiatv

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
JWT_SECRET=change-me

# Storage options: s3 | local
STORAGE_ADAPTER=local

# AWS S3 (required when STORAGE_ADAPTER=s3)
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_KEY
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Local storage (used when STORAGE_ADAPTER=local)
STORAGE_LOCAL_PATH=./tmp-storage

# TMDB options
# Accept self-signed certificates (helpful behind corporate proxies; off in production)
TMDB_ALLOW_SELF_SIGNED=1

# Blog / Editorial API (used for discovery home highlights)
BLOG_API_URL=https://blog.guiatv.com/api
