{
  "name": "guiatv",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev:non-ssr": "ng serve --configuration development --proxy-config proxy.conf.js --port 4200",
    "dev:non-ssr:open": "ng serve --configuration development --proxy-config proxy.conf.js --port 4200 --open",
    "build": "ng build",
    "build:watch": "ng build --configuration development --watch --output-path=dist/guiatv",
    "serve:static": "node --max-old-space-size=8192 node_modules/browser-sync/dist/bin.js start --config bs-config.js",
    "serve:static:open": "node --max-old-space-size=8192 node_modules/browser-sync/dist/bin.js start --config bs-config.js --open",
    "build:ssr": "ng build --configuration production --ssr",
    "serve:ssr": "node scripts/ssr-server.mjs",
    "serve:ssr:ng": "node dist/guiatv/server/main.server.mjs",
    "start:ssr": "npm run build:ssr && npm run serve:ssr",
    "dev:ssr": "ng serve --configuration development-ssr --proxy-config proxy.conf.js --port 3000",
    "prerender": "ng build --prerender",
    "start:prod": "npm run build:ssr && npm run serve:ssr"
  },
  "dependencies": {
    "@angular/animations": "20.0.0",
    "@angular/cdk": "20.0.1",
    "@angular/common": "20.0.0",
    "@angular/compiler": "20.0.0",
    "@angular/core": "20.0.0",
    "@angular/forms": "20.0.0",
    "@angular/localize": "20.0.0",
    "@angular/material": "20.0.1",
    "@angular/platform-browser": "20.0.0",
    "@angular/platform-browser-dynamic": "20.0.0",
    "@angular/platform-server": "20.0.0",
    "@angular/router": "20.0.0",
    "@angular/ssr": "20.0.4",
    "@types/leaflet": "^1.9.20",
    "bootstrap-icons": "^1.13.1",
    "compression": "^1.7.4",
    "domino": "^2.1.6",
    "embla-carousel": "^7.0.0",
    "express": "^4.21.2",
    "jsdom": "^27.2.0",
    "leaflet": "^1.9.4",
    "ngx-device-detector": "^11.0.0",
    "rxjs": "~7.8.0",
    "swiper": "^11.2.10",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "20.0.4",
    "@angular/cli": "20.0.4",
    "@angular/compiler-cli": "20.0.0",
    "@types/express": "^4.17.17",
    "@types/node": "^22.0.0",
    "autoprefixer": "^10.4.20",
    "browser-sync": "^3.0.4",
    "concurrently": "^8.2.0",
    "connect-history-api-fallback": "^2.0.0",
    "tailwindcss": "^3.4.13",
    "typescript": "5.8.3"
  }
}
